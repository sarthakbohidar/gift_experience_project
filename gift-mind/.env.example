# Get a key at https://console.groq.com/
GROQ_API_KEY=gsk_your_key_here

# Optional: Supabase (https://supabase.com) — persist chat threads server-side.
# Run supabase/migrations/001_gift_mind.sql in the SQL Editor after creating a project.
# Use the service role key only on the server (never expose in client bundles).
# In Supabase: Project Settings → API. Prefer the long JWT-style "service_role" secret (starts with eyJ…).
# If inserts fail with a newer sb_secret_… key, reveal/copy the legacy service_role JWT from the same page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
